<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="rounded_corners" parent="@style/Theme.MyApp">>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="menu_theme" parent="@style/Theme.MyApp">
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@color/background</item>
    </style>
    <style name="AppTheme.NavigationView" parent="@style/Theme.MyApp">
        <item name="itemIconTint">@color/onBackground</item>
        <item name="itemTextColor">@color/onBackground</item>
        <item name="android:background">@color/background</item>
        <item name="android:layout_width">match_parent</item>
    </style>
    <style name="RoundedDialog" parent="">
        <item name="android:background">@color/surface</item>
    </style>
    <style name="CustomDatePickerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:background">@color/surface</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/primary</item>
        <item name="android:textColorPrimaryInverse">@color/surface</item>
        <item name="android:textColorSecondary">@color/onSurface</item>
        <item name="android:textColorSecondaryInverse">@color/secondary</item>
        <item name="colorOnPrimary">@color/onSecondary</item>
    </style>
    <style name="CustomTimePickerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:background">@color/surface</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/primary</item>
        <item name="android:textColorPrimaryInverse">@color/surface</item>
        <item name="android:textColorSecondary">@color/onSurface</item>
        <item name="android:textColorSecondaryInverse">@color/secondary</item>
        <item name="colorOnPrimary">@color/onSecondary</item>
    </style>
</resources>