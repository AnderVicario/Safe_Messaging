<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/primary">

    <!-- Primer mensaje -->
    <TextView
        android:id="@+id/message_text_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:text="Mensaje 1" />

    <!-- Segundo mensaje -->
    <TextView
        android:id="@+id/message_text_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:text="Mensaje 2" />

    <!-- Tercer mensaje -->
    <TextView
        android:id="@+id/message_text_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:text="Mensaje 3" />

    <!-- Cuarto mensaje -->
    <TextView
        android:id="@+id/message_text_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:text="Mensaje 4" />

    <!-- Quinto mensaje -->
    <TextView
        android:id="@+id/message_text_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="@color/surface"
        android:textSize="16sp"
        android:text="Mensaje 5" />

</LinearLayout>
